rules_version = '2';
// Shared leaderboard for a small, trusted group: anyone can read; a player doc can only be
// written with the expected fields/types, and its id must be the lower-cased nickname.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{pid} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['name', 'xp', 'weekXp', 'solved', 'mastery', 'examBest', 'streak', 'level', 'lastActive', 'updated', 'data'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && pid == request.resource.data.name.lower()
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.data is string && request.resource.data.data.size() < 500000;
      allow delete: if false;
    }
  }
}
